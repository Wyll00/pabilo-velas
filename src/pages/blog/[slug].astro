---
// Un artículo del diario.
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CabeceraBlog from '../../components/CabeceraBlog.astro';
import { textos } from '../../i18n/index.js';
import { seVe } from '../../lib/blog.js';

export async function getStaticPaths() {
  const articulos = await getCollection('blog', seVe);
  return articulos.map((articulo) => ({
    params: { slug: articulo.slug },
    props: { articulo },
  }));
}

const { articulo } = Astro.props;
const lang = articulo.data.idioma;
const t = textos(lang);
const { Content } = await articulo.render();

const fechaLarga = articulo.data.fecha.toLocaleDateString(lang === 'en' ? 'en-GB' : 'es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Otros dos artículos del mismo idioma para seguir leyendo
const otros = (
  await getCollection('blog', (a) => seVe(a) && a.data.idioma === lang && a.id !== articulo.id)
)
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
  .slice(0, 2);

const raizBlog = lang === 'es' ? '/blog/' : `/${lang}/blog/`;

// Ficha del artículo para los buscadores
const articuloSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: articulo.data.titulo,
  description: articulo.data.resumen,
  datePublished: articulo.data.fecha.toISOString(),
  inLanguage: lang,
  author: { '@type': 'Organization', name: articulo.data.autor },
  publisher: { '@type': 'Organization', name: 'Pabilo' },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Layout lang={lang} titulo={`${articulo.data.titulo} · Pabilo`} descripcion={articulo.data.resumen}>
  <CabeceraBlog lang={lang} />

  <main class="articulo">
    <div class="contenedor">
      <a class="articulo__volver" href={raizBlog}>{t.blog.volver}</a>

      <header class="articulo__cabecera">
        <div class="articulo__meta">
          {articulo.data.borrador && <span class="marca-borrador">Borrador · no publicado</span>}
          {articulo.data.etiqueta && <span class="apunte__etiqueta">{articulo.data.etiqueta}</span>}
          <time datetime={articulo.data.fecha.toISOString()}>{fechaLarga}</time>
        </div>
        <h1 class="articulo__titulo">{articulo.data.titulo}</h1>
        <p class="articulo__resumen">{articulo.data.resumen}</p>
        <p class="articulo__autor">{t.blog.escritoPor} {articulo.data.autor}</p>
      </header>

      <div class="articulo__banda" style={`background: ${articulo.data.color};`} aria-hidden="true"></div>

      <div class="prosa">
        <Content />
      </div>

      {otros.length > 0 && (
        <aside class="articulo__mas">
          <div class="kicker">
            <span class="kicker__linea"></span>
            <span class="kicker__texto">{t.blog.tambien}</span>
          </div>
          <div class="articulo__mas-lista">
            {otros.map((otro) => (
              <a class="apunte-mini" href={`${raizBlog}${otro.slug}/`}>
                <span class="apunte-mini__punto" style={`background: ${otro.data.color};`} aria-hidden="true"></span>
                <span>
                  <strong>{otro.data.titulo}</strong>
                  <small>{otro.data.resumen}</small>
                </span>
              </a>
            ))}
          </div>
        </aside>
      )}
    </div>
  </main>

  <footer class="blog__pie">
    <div class="contenedor">
      <a href={lang === 'es' ? '/' : `/${lang}/`} class="marca" aria-label={t.nav.inicio}>pabilo</a>
      <p class="footer__desc">{t.footer.desc}</p>
    </div>
  </footer>

  <script type="application/ld+json" set:html={JSON.stringify(articuloSchema)} slot="head" />
</Layout>
