---
// Marco común de las tres páginas legales.
//
// Mientras falten los datos de src/data/empresa.js la página existe pero
// no se indexa y no se enlaza desde el pie: es preferible no tener aviso
// legal publicado a tener uno con huecos a la vista de todo el mundo.
import Layout from './Layout.astro';
import CabeceraBlog from '../components/CabeceraBlog.astro';
import { textos } from '../i18n/index.js';
import { hayDatosLegales, faltanLegales } from '../data/empresa.js';

const { titulo, resumen, actualizado } = Astro.props;
const lang = 'es';
const t = textos(lang);

const fecha = new Date(actualizado).toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Layout lang={lang} titulo={`${titulo} · Pabilo`} descripcion={resumen} sinIndexar={!hayDatosLegales}>
  <CabeceraBlog lang={lang} />

  <main class="articulo">
    <div class="contenedor">
      <a class="articulo__volver" href="/">{t.nav.inicio}</a>

      <header class="articulo__cabecera">
        <h1 class="articulo__titulo">{titulo}</h1>
        <p class="articulo__resumen">{resumen}</p>
        <p class="articulo__autor">Última actualización: {fecha}</p>
      </header>

      {!hayDatosLegales && (
        <p class="legal__pendiente">
          <strong>Borrador sin publicar.</strong> Faltan los datos de quien vende
          ({faltanLegales.join(', ')}). Esta página no aparece en el pie de la web ni
          en los buscadores hasta que se rellene <code>src/data/empresa.js</code>.
        </p>
      )}

      <div class="prosa">
        <slot />
      </div>
    </div>
  </main>

  <footer class="blog__pie">
    <div class="contenedor">
      <a href="/" class="marca" aria-label={t.nav.inicio}>pabilo</a>
      <p class="footer__desc">{t.footer.desc}</p>
    </div>
  </footer>
</Layout>

<style>
  .legal__pendiente {
    margin: 0 0 2.4rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--borde-fuerte);
    border-left: 3px solid var(--acento-texto);
    border-radius: 12px;
    background: var(--tarjeta);
    font-size: 14.5px;
    line-height: 1.6;
  }
  .legal__pendiente code {
    font-size: 0.92em;
  }
</style>
