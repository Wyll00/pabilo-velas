---
import '../styles/global.css';
import { velas } from '../data/velas.js';
import { contacto } from '../data/contacto.js';
import { faq } from '../data/faq.js';

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string;
}

const {
  titulo = 'Pabilo · Velas de autor',
  descripcion = 'Velas artesanales en pequeñas tandas, con cera de soja y cristal. El fuego de los pequeños placeres.',
  imagen = '/og.png',
} = Astro.props;

// URL absoluta de la página y de la imagen (para las tarjetas al compartir).
// Se apoyan en `site` de astro.config.mjs — cámbialo por el dominio real.
const urlCanonica = new URL(Astro.url.pathname, Astro.site).href;
const urlImagen = new URL(imagen, Astro.site).href;

// ── Datos estructurados (Schema.org) ──
// Le explican a Google qué es Pabilo, qué vende y a qué precio, para que
// pueda mostrar la ficha del negocio y las velas en los resultados.
const perfiles = [
  contacto.instagram && `https://instagram.com/${contacto.instagram}`,
].filter(Boolean);

const datosEstructurados = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      '@id': `${new URL('/', Astro.site).href}#negocio`,
      name: 'Pabilo',
      description: descripcion,
      slogan: 'El fuego de los pequeños placeres',
      url: new URL('/', Astro.site).href,
      image: urlImagen,
      priceRange: '20 € - 24 €',
      areaServed: contacto.ciudad,
      address: { '@type': 'PostalAddress', addressRegion: contacto.ciudad, addressCountry: 'ES' },
      ...(contacto.email && { email: contacto.email }),
      ...(perfiles.length && { sameAs: perfiles }),
    },
    {
      '@type': 'ItemList',
      name: 'Colección de velas Pabilo',
      itemListElement: velas.map((v, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'Product',
          name: v.nombre,
          description: v.nota,
          category: v.familia,
          brand: { '@type': 'Brand', name: 'Pabilo' },
          offers: {
            '@type': 'Offer',
            price: String(v.precio),
            priceCurrency: 'EUR',
            availability: 'https://schema.org/InStock',
            seller: { '@type': 'Organization', name: 'Pabilo' },
          },
        },
      })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.pregunta,
        acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={urlCanonica} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#2B2521" />

    <!-- Open Graph (tarjeta al compartir en WhatsApp, Instagram, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pabilo" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image" content={urlImagen} />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={urlImagen} />

    <!-- Fuentes: Instrument Sans (UI) + Newsreader (display/serif) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Newsreader:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&display=swap"
      rel="stylesheet"
    />

    <!-- Datos estructurados para buscadores -->
    <script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />

    <!-- Deja la vela encendida antes de pintar, para que no parpadee al cargar -->
    <script is:inline>
      try {
        if (localStorage.getItem('pabilo-noche') === '1') {
          document.documentElement.classList.add('noche');
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
