---
import '../styles/global.css';
import { velas } from '../data/velas.js';
import { contacto } from '../data/contacto.js';
import { faq } from '../data/faq.js';
import { textos, campo, idiomas } from '../i18n/index.js';

interface Props {
  lang?: string;
  titulo?: string;
  descripcion?: string;
  imagen?: string;
  /** Esta misma página en otros idiomas. Si no se pasan, no se declara
   *  ninguna: es mejor callar que señalar una traducción que no existe. */
  alternativas?: { codigo: string; href: string }[];
  /** Solo las portadas enseñan el catálogo y las preguntas frecuentes,
   *  así que solo ellas los declaran a los buscadores. */
  catalogo?: boolean;
  /** 'article' en los artículos del diario. */
  tipoOg?: string;
  /** true en páginas que no deben indexarse (p. ej. la de error). */
  sinIndexar?: boolean;
}

const {
  lang = 'es',
  titulo,
  descripcion,
  imagen = '/og.jpg',
  alternativas = [],
  catalogo = false,
  tipoOg = 'website',
  sinIndexar = false,
} = Astro.props;
const t = textos(lang);

const tituloFinal = titulo ?? t.meta.titulo;
const descripcionFinal = descripcion ?? t.meta.descripcion;

// URL absoluta de la página y de la imagen (para las tarjetas al compartir).
// Se apoyan en `site` de astro.config.mjs — cámbialo por el dominio real.
const urlCanonica = new URL(Astro.url.pathname, Astro.site).href;
const urlImagen = new URL(imagen, Astro.site).href;

// Las señas del negocio no cambian de una página a otra.
const urlSitio = new URL('/', Astro.site).href;
const imagenSitio = new URL('/og.jpg', Astro.site).href;

// ── Datos estructurados (Schema.org) ──
// Le explican a Google qué es Pabilo, qué vende y a qué precio, para que
// pueda mostrar la ficha del negocio y las velas en los resultados.
//
// Van en dos partes a propósito: la ficha del negocio acompaña a toda la
// web, pero el catálogo y las preguntas frecuentes solo se declaran donde
// de verdad están, que son las portadas. Declararlos en un artículo del
// diario describiría un contenido que esa página no tiene.
const perfiles = [contacto.instagram && `https://instagram.com/${contacto.instagram}`].filter(Boolean);

const negocio = {
  '@type': 'LocalBusiness',
  '@id': `${urlSitio}#negocio`,
  name: 'Pabilo',
  // Estables: son las del negocio, no las de la página que toque.
  description: t.meta.descripcion,
  slogan: t.hero.tituloAntes + t.hero.tituloEnfasis,
  url: urlSitio,
  image: imagenSitio,
  priceRange: '20 € - 24 €',
  areaServed: t.contacto.lugar,
  address: { '@type': 'PostalAddress', addressRegion: t.contacto.lugar, addressCountry: 'ES' },
  ...(contacto.email && { email: contacto.email }),
  ...(perfiles.length && { sameAs: perfiles }),
};

const listaDeVelas = {
  '@type': 'ItemList',
  name: t.coleccion.eyebrow,
  itemListElement: velas.map((v, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: campo(v, 'nombre', lang),
      description: campo(v, 'nota', lang),
      category: campo(v, 'familia', lang),
      brand: { '@type': 'Brand', name: 'Pabilo' },
      offers: {
        '@type': 'Offer',
        price: String(v.precio),
        priceCurrency: 'EUR',
        // ⚠️ Se declara disponible siempre. Cuando haya control real de
        //    existencias, esto debe salir de ahí: decirle a Google que hay
        //    stock mientras el mensaje de pedido pregunta si queda es una
        //    contradicción que acaba pagando quien compra.
        availability: 'https://schema.org/InStock',
        seller: { '@type': 'Organization', name: 'Pabilo' },
      },
    },
  })),
};

const preguntas = {
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: campo(f, 'pregunta', lang),
    acceptedAnswer: { '@type': 'Answer', text: campo(f, 'respuesta', lang) },
  })),
};

const datosEstructurados = {
  '@context': 'https://schema.org',
  '@graph': catalogo ? [negocio, listaDeVelas, preguntas] : [negocio],
};
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{tituloFinal}</title>
    <meta name="description" content={descripcionFinal} />
    <link rel="canonical" href={urlCanonica} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#2B2521" />
    {sinIndexar && <meta name="robots" content="noindex, follow" />}

    <!-- La misma página en cada idioma. Solo se declara cuando la traducción
         existe de verdad: apuntar de un artículo a la portada le diría a Google
         que son la misma página, y no lo son. -->
    {alternativas.length > 0 && alternativas.map((alt) => (
      <link rel="alternate" hreflang={alt.codigo} href={alt.href} />
    ))}
    {alternativas.length > 0 && <link rel="alternate" hreflang="x-default" href={urlSitio} />}

    <!-- Open Graph (tarjeta al compartir en WhatsApp, Instagram, etc.) -->
    <meta property="og:type" content={tipoOg} />
    <meta property="og:site_name" content="Pabilo" />
    <meta property="og:title" content={tituloFinal} />
    <meta property="og:description" content={descripcionFinal} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image" content={urlImagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={t.ogLocale} />
    {Object.values(idiomas)
      .filter((otro) => otro.codigo !== lang)
      .map((otro) => <meta property="og:locale:alternate" content={otro.ogLocale} />)}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloFinal} />
    <meta name="twitter:description" content={descripcionFinal} />
    <meta name="twitter:image" content={urlImagen} />

    <!-- Fuentes: Instrument Sans (UI) + Newsreader (display/serif) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Newsreader:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&display=swap"
      rel="stylesheet"
    />

    <!-- Datos estructurados para buscadores -->
    <script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />

    <!-- Lo que cada página quiera añadir al <head> (p. ej. la ficha de un artículo) -->
    <slot name="head" />

    <!-- Deja la vela encendida antes de pintar, para que no parpadee al cargar -->
    <script is:inline>
      try {
        if (localStorage.getItem('pabilo-noche') === '1') {
          document.documentElement.classList.add('noche');
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
